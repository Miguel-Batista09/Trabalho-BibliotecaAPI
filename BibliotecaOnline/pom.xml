<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot como projeto-pai (gerencia as versões das dependências) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>br.edu.biblioteca</groupId>
    <artifactId>BibliotecaOnline</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>BibliotecaOnline</name>
    <description>Projeto BibliotecaOnline convertido em API Spring Boot com integracao via RestTemplate</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web: REST Controllers, RestTemplate, Jackson (JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok REMOVIDO do projeto: o erro "java.lang.ExceptionInInitializerError
             com.sun.tools.javac.code.TypeTag :: UNKNOWN" ocorre quando a versao do
             Lombok nao e compativel com o JDK usado pelo compilador do Eclipse/VS Code.
             O LivroDTO agora possui getters/setters manuais, como no roteiro da aula. -->

        <!-- Testes (opcional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>BibliotecaOnline</finalName>
        <plugins>
            <!-- Plugin Maven do Spring Boot: mvn spring-boot:run / mvn package -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
